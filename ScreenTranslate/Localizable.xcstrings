          }
        }
      }
    },
    "Apple Vision and Apple Translation are the defaults and need no API key. Their language models may need a one-time system download. The app has no screenshot-upload server, analytics, account or ads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision and Apple Translation are the defaults and need no API key. Their language models may need a one-time system download. The app has no screenshot-upload server, analytics, account or ads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认使用 Apple Vision 与苹果翻译，无需 API Key。系统可能需要首次下载语言模型。App 没有自有截图上传服务器、统计追踪、账号或广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設使用 Apple Vision 與蘋果翻譯，無需 API Key。系統可能需要首次下載語言模型。App 沒有自有截圖上傳伺服器、統計追蹤、賬號或廣告。"
          }
        }
      }
    },
    "Temporary by default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary by default"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认仅临时使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設僅臨時使用"
          }
        }
      }
    },
    "When history is off, imported screenshots stay in memory until Close. Shortcuts uses a protected, temporary handoff file, deleted when consumed or expired. No image is added to Photos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When history is off, imported screenshots stay in memory until Close. Shortcuts uses a protected, temporary handoff file, deleted when consumed or expired. No image is added to Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭历史记录时，截图只在处理和查看期间保留于内存。App 内打开模式的快捷指令使用受保护的临时交接文件，读取时删除，过期内容会被丢弃。不向相册写入图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉歷史記錄時，截圖只在處理和檢視期間保留於記憶體。App 內開啟模式的快捷指令使用受保護的臨時交接檔案，讀取時刪除，過期內容會被丟棄。不向相簿寫入圖片。"
          }
        }
      }
    },
    "Optional cloud processing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional cloud processing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的云端处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選的雲端處理"
          }
        }
      }
    },
    "Only selecting an AI engine and granting permission sends data to your configured HTTPS provider: an image for AI OCR, or recognized text for AI translation. Permission is tied to the endpoint and model. Provider retention policies and fees apply. API keys are kept in the device Keychain and never written to logs or history.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selecting an AI engine and granting permission sends data to your configured HTTPS provider: an image for AI OCR, or recognized text for AI translation. Permission is tied to the endpoint and model. Provider retention policies and fees apply. API keys are kept in the device Keychain and never written to logs or history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在选择 AI 引擎并授权后，才会向指定的 HTTPS 服务发送数据：AI 识别发送图片，AI 翻译发送文字。许可绑定服务地址和模型。数据保留与费用以服务商政策为准。密钥保存在本机钥匙串，不写入日志或历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在選擇 AI 引擎並授權後，才會向指定的 HTTPS 服務傳送資料：AI 識別傳送圖片，AI 翻譯傳送文字。許可繫結服務地址和模型。資料保留與費用以服務商政策為準。金鑰儲存在本機鑰匙串，不寫入日誌或歷史。"
          }
        }
      }
    },
    "History is your choice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is your choice"
