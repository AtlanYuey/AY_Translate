    "Saving does not send a request. Select a service for OCR or translation; sharing requires your permission. Apple engines remain free without a key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving does not send a request. Select a service for OCR or translation; sharing requires your permission. Apple engines remain free without a key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存设置不会发送请求。选择服务用于识别或翻译后，分享数据前会征求许可；苹果本机引擎始终无需密钥即可免费使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存設定不會傳送請求。選擇服務用於識別或翻譯後，分享資料前會徵求許可；蘋果本機引擎始終無需金鑰即可免費使用。"
          }
        }
      }
    },
