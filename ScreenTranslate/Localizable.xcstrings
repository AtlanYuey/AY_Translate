    "Apple Vision uses accurate recognition, language correction and automatic detection. AI OCR sends a screenshot only with permission; uncertain positions appear in Full Text.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision uses accurate recognition, language correction and automatic detection. AI OCR sends a screenshot only with permission; uncertain positions appear in Full Text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision 使用高精度识别、语言校正和自动检测。AI 识别仅在许可后发送截图；无法可靠定位的文字会放入全文阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Vision 使用高精度識別、語言校正和自動檢測。AI 識別僅在許可後傳送截圖；無法可靠定位的文字會放入全文閱讀。"
          }
        }
      }
    },
    "Apple Translation is free and uses downloaded on-device models. Speed favors low latency; Quality keeps longer paragraphs together and gives AI more output space and screen context.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation is free and uses downloaded on-device models. Speed favors low latency; Quality keeps longer paragraphs together and gives AI more output space and screen context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果翻译免费使用本机语言模型。速度优先减少等待；质量优先保留更完整的段落，并为 AI 提供更多输出空间与画面上下文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蘋果翻譯免費使用本機語言模型。速度優先減少等待；質量優先保留更完整的段落，併為 AI 提供更多輸出空間與畫面上下文。"
          }
        }
      }
    },
